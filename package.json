{
  "name": "dsh-workbuddy-summon",
  "icon": "./assets/icon.svg",
  "version": "0.4.0",
  "type": "module",
  "description": "把 WorkBuddy 的专家团 / 专家做成可在 DSH 里召唤的目录：内置「全域智囊团」固化包（16 个 agent / 15 个技能，离线、换机即用），叠加官方专家中心 448 条与登录态在线市场（28k+）；未召唤零注入。0.2.0 起已移除连接器功能。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zfei2080/dsh-workbuddy-summon.git"
  },
  "homepage": "https://github.com/zfei2080/dsh-workbuddy-summon#readme",
  "bugs": {
    "url": "https://github.com/zfei2080/dsh-workbuddy-summon/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "expert-team",
    "workbuddy",
    "agents"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "meta": {
    "title": "WorkBuddy 专家召唤",
    "description": "内置离线可用的「全域智囊团」固化包，并可召唤 WorkBuddy 官方 448 条与在线市场专家；未召唤时完全不注入。"
  },
  "files": [
    "index.js",
    "lib/",
    "packs/",
    "bin/",
    "locale/",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bin": {
    "westock-data": "./bin/westock-data",
    "westock-tool": "./bin/westock-tool"
  }
}
